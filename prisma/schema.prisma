generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdType {
  BANNER
  INTERSTITIAL
  REWARDED
  APP_OPEN
  DIRECT
}

enum ServiceType {
  food
  ride
  handyman
  moving
}

enum OrderStatus {
  pending
  matching
  accepted
  in_progress
  completed
  cancelled
  disputed
  // Legacy talabat statuses preserved for backward compatibility
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum VehicleType {
  walking
  bicycle
  motorcycle
  sedan
  pickup
  van
  small_truck
  large_truck
}

enum OfferStatus {
  pending
  accepted
  rejected
  expired
}

enum TransactionType {
  topup
  payout
  commission
  refund
}

enum NotificationChannel {
  push
  sms
  email
}

model User {
  id               String            @id @default(cuid())
  name             String
  phone            String            @unique
  email            String?           @unique
  password         String
  role             String            @default("USER") // Legacy single-role field
  status           String            @default("active") // "active" or "suspended"
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt

  // Multi-role relations (RBAC)
  roles            UserRole[]
  providerProfile  ProviderProfile?
  vendors          Vendor[]
  
  // Orders
  orders           Order[]           @relation("CustomerOrders")
  ordersAsProvider Order[]           @relation("ProviderOrders")
  
  // Wallet, Notifications, Chat, AI, Bidding, Reviews
  wallet           WalletAccount?
  notifications    Notification[]
  chatMessages     ChatMessage[]
  aiLogs           AiSuggestionLog[]
  biddingRequests  BiddingRequest[]
  offers           Offer[]
  reviewsAuthored  Review[]          @relation("AuthorReviews")
  providerKyc      ProviderKyc?
  safetyAlerts     SafetyAlert[]     @relation("UserSafetyAlerts")
  transferRequests WalletTransferRequest[] @relation("RequestedTransfers")
  roleRequests     RoleRequest[]
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique // customer, driver, worker, partner, admin, supervisor
  users       UserRole[]
  permissions RolePermission[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // e.g. order.cancel, wallet.payout.approve, kyc.review, admin.view
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model ServiceCategory {
  id               String                    @id @default(cuid())
  name             String
  parentId         String?
  parent           ServiceCategory?          @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children         ServiceCategory[]         @relation("CategoryHierarchy")
  providers        ProviderServiceCategory[]
  vendors          Vendor[]
  orders           Order[]
  biddingRequests  BiddingRequest[]
}

model ProviderProfile {
  id                 String                    @id @default(cuid())
  userId             String                    @unique
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType        VehicleType?
  isAvailable        Boolean                   @default(true)
  currentLat         Float?
  currentLng         Float?
  lastLocationUpdate DateTime?
  bio                String?
  profession         String?
  vehicleDetails     String?
  skills             String[]                  @default([])
  experienceYears    Int?                      @default(1)
  totalDeliveries    Int                       @default(0)
  lateDeliveries     Int                       @default(0)
  avgRating          Decimal?                  @db.Decimal(3, 2)
  serviceCategories  ProviderServiceCategory[]
}

model ProviderServiceCategory {
  id                String          @id @default(cuid())
  providerProfileId String
  serviceCategoryId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  serviceCategory   ServiceCategory @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)

  @@unique([providerProfileId, serviceCategoryId])
}

model Vendor {
  id          String          @id @default(cuid())
  ownerUserId String
  owner       User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name        String
  categoryId  String
  category    ServiceCategory @relation(fields: [categoryId], references: [id])
  address     String
  isOpen      Boolean         @default(true)
  menuItems   MenuItem[]
  products    Product[]
}

model MenuItem {
  id          String   @id @default(cuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name        String
  price       Decimal  @db.Decimal(10, 2)
  isAvailable Boolean  @default(true)
}

// Legacy Category kept and compatible
model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  imageUrl String?
  active   Boolean   @default(true)
  products Product[]
}

// Legacy Product extended with optional vendor linkage
model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  price       Decimal     @db.Decimal(10, 2)
  imageUrl    String?
  active      Boolean     @default(true)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  vendorId    String?
  vendor      Vendor?     @relation(fields: [vendorId], references: [id])
  orderItems  OrderItem[]
}

// Order model extended to serve ALL MoveX services
model Order {
  id                  String              @id @default(cuid())
  userId              String              // Customer ID
  user                User                @relation("CustomerOrders", fields: [userId], references: [id])
  providerId          String?
  provider            User?               @relation("ProviderOrders", fields: [providerId], references: [id])
  serviceType         ServiceType         @default(food)
  serviceCategoryId   String?
  serviceCategory     ServiceCategory?    @relation(fields: [serviceCategoryId], references: [id])
  status              OrderStatus         @default(pending)
  pickupLat           Float?
  pickupLng           Float?
  dropoffLat          Float?
  dropoffLng          Float?
  requiredVehicleType VehicleType?
  total               Decimal             @default(0.00) @db.Decimal(10, 2)
  priceFinal          Decimal?            @db.Decimal(10, 2)
  address             String?
  phone               String?
  deliveryUrgency     String?             @default("standard") // "express", "standard", "relaxed"
  vendorStatus        String?             @default("pending")  // "pending", "preparing", "ready_for_pickup", "picked_up"
  courierId           String?
  vendorPreparedAt    DateTime?
  courierPickedUpAt   DateTime?
  courierDeliveredAt  DateTime?
  customerReceivedAt  DateTime?
  workerFinishedAt    DateTime?
  customerConfirmedAt DateTime?
  payload             Json?
  estimatedDeliveryAt DateTime?           // AI-calculated ETA set at order creation
  etaMinutes          Int?                // Estimated minutes for delivery
  isLateDelivery      Boolean?            @default(false)  // Flagged if driver was late
  lateByMinutes       Int?                // How many minutes late (actual - estimated)
  createdAt           DateTime            @default(now())
  completedAt         DateTime?

  items               OrderItem[]
  transactions        WalletTransaction[]
  chatMessages        ChatMessage[]
  offers              Offer[]
  aiLogs              AiSuggestionLog[]
  review              Review?
  safetyAlerts        SafetyAlert[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model BiddingRequest {
  id                String          @id @default(cuid())
  customerId        String
  customer          User            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceType       ServiceType
  serviceCategoryId String
  serviceCategory   ServiceCategory @relation(fields: [serviceCategoryId], references: [id])
  status            String          @default("open") // open, accepted, cancelled, expired
  pickupLat         Float?
  pickupLng         Float?
  dropoffLat        Float?
  dropoffLng        Float?
  details           Json?
  createdAt         DateTime        @default(now())

  offers            Offer[]
}

model Offer {
  id               String          @id @default(cuid())
  biddingRequestId String?
  biddingRequest   BiddingRequest? @relation(fields: [biddingRequestId], references: [id], onDelete: Cascade)
  orderId          String?
  order            Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  providerId       String
  provider         User            @relation(fields: [providerId], references: [id], onDelete: Cascade)
  amount           Decimal         @db.Decimal(10, 2)
  message          String?
  status           OfferStatus     @default(pending)
  createdAt        DateTime        @default(now())
}

model WalletAccount {
  id              String               @id @default(cuid())
  userId          String               @unique
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance         Decimal              @default(0.00) @db.Decimal(12, 2)
  overdraftLimit  Decimal              @default(0.00) @db.Decimal(12, 2)
  securityPin     String?
  currency        String               @default("EGP")
  transactions    WalletTransaction[]
  topupRequests   WalletTopupRequest[]
}

model WalletTransaction {
  id              String          @id @default(cuid())
  walletAccountId String
  walletAccount   WalletAccount   @relation(fields: [walletAccountId], references: [id], onDelete: Cascade)
  orderId         String?
  order           Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  referenceId     String?
  senderName      String?
  recipientName   String?
  amount          Decimal         @db.Decimal(12, 2)
  preBalance      Decimal?        @db.Decimal(12, 2)
  postBalance     Decimal?        @db.Decimal(12, 2)
  status          String          @default("COMPLETED")
  type            TransactionType
  description     String?
  createdAt       DateTime        @default(now())
}

model CommissionRule {
  id          String      @id @default(cuid())
  serviceType ServiceType @unique
  percentage  Decimal     @db.Decimal(5, 2)
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  channel   NotificationChannel
  status    String              @default("sent")
  createdAt DateTime            @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}

model AiSuggestionLog {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId        String?
  order          Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  inputContext   Json
  suggestion     Json
  acceptedByUser Boolean?
  createdAt      DateTime @default(now())
}

model AdConfig {
  id            String   @id @default(cuid())
  type          AdType
  enabled       Boolean  @default(true)
  placement     String
  frequency     Int      @default(3)
  unitIdAndroid String?
  unitIdIos     String?
  updatedAt     DateTime @updatedAt
}

model Review {
  id         String   @id @default(cuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation("AuthorReviews", fields: [authorId], references: [id], onDelete: Cascade)
  targetId   String?  // Target provider ID or vendor ID
  rating     Int      // 1 to 5 stars
  comment    String?
  createdAt  DateTime @default(now())
}

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  discountPct Decimal  @db.Decimal(5, 2)
  maxDiscount Decimal  @db.Decimal(10, 2)
  minOrder    Decimal  @db.Decimal(10, 2)
  expiresAt   DateTime
  isActive    Boolean  @default(true)
}

model OtpVerification {
  id         String   @id @default(cuid())
  phone      String
  code       String
  expiresAt  DateTime
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([phone, code])
}

model ProviderKyc {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nationalIdNumber   String
  licenseNumber      String
  vehiclePlateNumber String?
  status             String    @default("APPROVED") // PENDING, APPROVED, REJECTED
  submittedAt        DateTime  @default(now())
  reviewedAt         DateTime?
}

model SafetyAlert {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserSafetyAlerts", fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  reason    String
  lat       Float?
  lng       Float?
  priority  String   @default("CRITICAL")
  status    String   @default("DISPATCHED") // DISPATCHED, RESOLVED, FALSE_ALARM
  createdAt DateTime @default(now())
}

model WalletTransferRequest {
  id             String    @id @default(cuid())
  requesterId    String
  requester      User      @relation("RequestedTransfers", fields: [requesterId], references: [id], onDelete: Cascade)
  payerPhone     String
  amount         Decimal   @db.Decimal(12, 2)
  note           String?
  status         String    @default("PENDING") // PENDING, ACCEPTED, REJECTED, EXPIRED
  createdAt      DateTime  @default(now())
  settledAt      DateTime?
}

model RoleRequest {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedRole  String    // driver, worker, partner
  profession     String?
  vehicleDetails String?
  bio            String?
  status         String    @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNotes     String?
  createdAt      DateTime  @default(now())
  reviewedAt     DateTime?
}

// ---------------------------------------------------------------------------
// Platform-wide dynamic configuration (replaces all hardcoded values)
// ---------------------------------------------------------------------------
model SystemConfig {
  key         String   @id   // e.g. driver_overdraft_limit, default_commission_pct
  value       String         // stored as string, cast in application layer
  description String?
  updatedBy   String?        // admin userId who last changed this
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Wallet Top-up via Manual Transfer Proof (Instapay / Vodafone Cash)
// ---------------------------------------------------------------------------
model WalletTopupRequest {
  id              String        @id @default(cuid())
  walletAccountId String
  walletAccount   WalletAccount @relation(fields: [walletAccountId], references: [id], onDelete: Cascade)
  paymentMethod   String        // "instapay" | "vodafone_cash" | "bank_transfer"
  platformAccount String        // the platform number/account shown to user
  declaredAmount  Decimal       @db.Decimal(12, 2)
  proofImageUrl   String?       // URL of uploaded screenshot/proof
  proofText       String?       // Optional description from user
  aiVerdict       String?       // "CONFIRMED" | "SUSPICIOUS" | "MANUAL_REVIEW"
  aiConfidence    Decimal?      @db.Decimal(5, 2)
  aiNotes         String?
  status          String        @default("PENDING") // PENDING, APPROVED, REJECTED, AI_FLAGGED
  adminNotes      String?
  reviewedBy      String?       // admin userId
  reviewedAt      DateTime?
  creditedAt      DateTime?
  createdAt       DateTime      @default(now())
}
